;; The counted loop and the switch, in two languages that spell both
;; differently.
;;
;; `gcd.kin` exercises `defn`, `let`, `set`, `while`, `return` and the
;; operators. This one exists for `for` and `case`, which diverge more than
;; anything else in the shape vocabulary:
;;
;;   * Go writes `for i := 0; i < n; i++` and Java `for (int i = 0; ...)` --
;;     C-shaped in both, but Go takes the counter's type from the start
;;     expression and has no parentheses.
;;   * Go's `switch` needs no `break` because it does not fall through, and
;;     puts every label of an arm on one `case` separated by commas. Java
;;     needs one `case` per label and `return`s out of each arm to avoid
;;     falling into the next.
;;
;; Neither difference shows up in a file that generates but is never
;; compiled, which is why this is in `./check` rather than in a test that
;; compares strings.
(ns example.loops
  (:require [example.lang :refer [I32]]
            [kin.lang :refer [defn return let set for case defconst defstruct defdata +]]))

;; A constant, which each language spells its own way: Rust and Java scream
;; it, C# and GO pascalise it -- Effective Go says `MixedCaps`, never
;; `SCREAMING_SNAKE`, and `^:pub` decides the first letter because Go spells
;; visibility in the name.
(defconst ^:pub ^I32 STEP_LIMIT 5)

(defn ^:pub ^I32 sum-to [^I32 n]
  (let [^I32 acc 0]
    (for [^I32 i 0 n]
      (set acc (+ acc i)))
    (return acc)))

(defn ^:pub ^I32 classify [^I32 x]
  (case x
    [0] 100
    [1 2] 200
    :else 300))

;; AND A REFERENCE to it, which is the half a declaration test misses. A
;; constant belongs to the module that declares it, so `spell-name` answers
;; per target -- and until `const-spellings` was asked about `:go` it had no
;; answer there and would have emitted nothing at all.
(defn ^:pub ^I32 sum-limit []
  (return (sum-to STEP_LIMIT)))

;; A STRUCT, DECLARED ONLY, and the limit is worth stating rather than
;; hiding: `defstruct` has no constructor form, and its own tag cannot be
;; used as an annotation either -- `kin/tag` resolves through the file's
;; REQUIRE SCOPE, so a tag `define-tag!` registers while generating is not
;; reachable as `^span` on a parameter. That is true of all four targets and
;; predates Go; see the note in nome's ROADMAP.
;;
;; So what this checks is that the DECLARATION compiles in both languages,
;; which is weaker than everything else in this file. Go writes a named
;; struct type at package level, Java a static nested class, and the field
;; names go through the same namer `(. p x)` would read them with.
(defstruct span [^I32 lo ^I32 hi])

;; A DATA TABLE, laid out by `kin.lang/flat-array` -- Rust `[T; N]`, Java and
;; C# `T[]`, and Go `[N]T`, which mirrors Rust because the length is known
;; and saying so in the type is what Go does when it is fixed.
;;
;; THE FIRST ACCESSOR ARGUMENT IS THE RECEIVER SLOT, `{0}`, which
;; `flat-array` says a module-level table has no use for. flint passes its
;; runtime there; this example has nothing to pass, so it passes `0` and the
;; generated body ignores it. Arity is what picks the template: one argument
;; is the LENGTH, two is an INDEX.
;;
;; The accessors are ORDINARY BINDINGS -- they go through `declared-call`,
;; the same machinery a `defn` call uses -- so `(squares-at 0 i)` is a call
;; like any other and the source never learns which target is reading it.
(defdata ^:pub squares
  :emitter kin.lang/flat-array
  :data [0 1 4 9 16 25]
  :accessors {^I32 squares-n  [^I32 ignored]
              ^I32 squares-at [^I32 ignored ^I32 i]})

(defn ^:pub ^I32 square-of [^I32 i]
  (return (squares-at 0 i)))
