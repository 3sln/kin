;; Euclid, in two languages kin has never heard of.
;;
;; Nothing in kin knows the word `go` or the word `java`. The targets are
;; described in `src/example/targets.cljc` and the forms in
;; `src/example/lang.cljc`, both ordinary files in this example project.
;;
;; ONE SOURCE, TWO FILE SHAPES. Go gets a module file -- `package gcd`, then
;; imports, then functions. Java gets a class file at the package path --
;; `package example;`, then imports, then `public final class Gcd` with the
;; functions inside it. Each target's `:emit` writes its own; kin has no
;; opinion about either.
(ns example.gcd
  ;; TWO REQUIRES, AND `kin.lang` IS THE SHIPPED ONE. The shape forms come
  ;; from `kin.lang` -- Go's arms from the map `example.lang` contributes to
  ;; that namespace, Java's from `kin.lang` itself -- and the tags and
  ;; `to-str` from this example's own subject vocabulary. Nothing here says
  ;; which map answers, and nothing here would change if a fifth language
  ;; were added.
  (:require [kin.lang :refer [defn return let set while comment != > rem]]
            [example.lang :refer [to-str I32 Str]]))

(defn ^I32 gcd [^I32 a ^I32 b]
  (comment "Euclid's algorithm, by repeated remainder.")
  (let [x a
        y b]
    (while (!= y 0)
      ;; `^I32` IS REQUIRED HERE, and it is `kin.lang`'s contract rather than
      ;; an accident. `kin.lang`'s own vocabulary carries NO default tag --
      ;; what an untagged binding means is a subject's choice -- and its
      ;; operators do not tag their product, so nothing can infer what
      ;; `(rem x y)` is. Go would not have cared: `:=` infers, and the
      ;; annotation is ignored by the arm that writes it. Java needs the type
      ;; written out, and this is where it comes from.
      ;;
      ;; `x` and `y` need no annotation because `defn` registers a tag for
      ;; every parameter, so they infer from `a` and `b`.
      (let [^I32 t (rem x y)]
        (set x y)
        (set y t)))
    (return x)))

;; `to-str` needs `strconv` in Go and `java.util.Objects` in Java, and it is
;; discovered HERE, in the middle of the file. The import appears at the top
;; regardless, because `:emit` dropped an anchor there before any of this ran.
(defn ^Str gcd-label [^I32 a ^I32 b]
  (comment "The answer, as text -- which is what needs the import.")
  (return (to-str (gcd a b))))
