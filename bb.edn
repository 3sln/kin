;; kin is a LIBRARY: `:paths` is the whole of what a consumer needs.
;;
;; `bb test` runs the fifteen test files. They are plain scripts rather than a
;; framework because kin has one dependency-free runtime requirement -- a
;; reader -- and a test harness that needed more would be the first thing to
;; break the claim.
{:paths ["src"]
 :tasks {test {:doc "Run every test."
               :task (doseq [t ["tags" "emit" "diagnostics" "exports" "promises" "contexts" "link" "host" "reserved" "literals" "data" "gothrows" "grouping" "aliasing"
                            "arity"]]
                       (let [r (shell {:continue true} "bb" (str "test/" t ".clj"))]
                         (when-not (zero? (:exit r)) (System/exit 1))))}}}
