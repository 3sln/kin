#!/usr/bin/env bb
;; kin: write a unit of logic once, emit it for every target.
;;
;; Three commands, and the middle one is the point:
;;
;;   kin gen     <source.kin>   print what each target would get
;;   kin verify  <source.kin>   compile and RUN all three, require identical output
;;   kin emit    <source.kin>   substitute into the target files, between markers
;;
;; A project says what its vocabularies are in `kin.edn`; this knows nothing
;; about any particular runtime.
(require '[kin] '[clojure.string :as str] '[clojure.edn :as edn] '[kin.target :as target])

;; A project's `kin.edn` names its vocabularies and, optionally, its TARGETS.
;; `:targets` may be a vector of keys naming kin's defaults, or a map of full
;; descriptors -- a project targeting a language kin has never heard of writes
;; the descriptor itself and kin needs no change.
(def cfg (if (.exists (java.io.File. "kin.edn"))
           (edn/read-string (slurp "kin.edn"))
           {:vocabularies []}))

(def targets
  (let [t (:targets cfg [:rust :java :csharp])]
    (if (map? t)
      (reduce-kv (fn [m k v] (assoc m k (merge (get target/defaults k) v))) {} t)
      (select-keys target/defaults t))))

;; A VOCABULARY IS ONE VAR, holding one map.
;;
;; It used to be three vars found by convention -- `forms-for`, `tags-for`,
;; `names-for` -- resolved by name and merged. That made the vocabulary
;; something kin ASSEMBLED rather than something the namespace SAID, so a
;; namespace could not declare which targets it speaks, could not be checked,
;; and could not be told apart from a namespace that happened to have a
;; function called `forms-for` in it.
(defn load-vocabulary
  "Require `nsym` and read the vocabulary it declares.

  The var may hold the map or a function returning one; a subject that builds
  its forms by merging wants the latter, and both are the same value by the
  time anything asks."
  [nsym]
  (require nsym)
  (let [var (or (resolve (symbol (str nsym) "vocabulary"))
                (throw (ex-info
                        (str "kin: " nsym " declares no `vocabulary`. A"
                             " vocabulary is a var holding a map -- see"
                             " `kin/vocabulary` -- so that it can say which"
                             " targets it speaks.")
                        {:namespace nsym})))
        v (if (fn? @var) (@var) @var)]
    (when-not (= nsym (:namespace v))
      (throw (ex-info (str "kin: " nsym "/vocabulary calls itself "
                           (pr-str (:namespace v))
                           " -- a vocabulary's `:namespace` is how a source"
                           " requires it, so the two have to agree")
                      {:namespace nsym :declared (:namespace v)})))
    (kin/check-vocabulary v)))

(def vocabs
  (into {} (for [v (:vocabularies cfg)] [v (load-vocabulary v)])))

(defn generate
  "The source, rendered for every target. `[[target text] ...]`."
  [path]
  (let [src (slurp path)
        all (edn/read-string {:readers {}} (str "[" src "]"))
        ns-form (first (filter #(and (seq? %) (= 'ns (first %))) all))
        forms (vec (remove #(and (seq? %) (= 'ns (first %))) all))
        scope (when ns-form (kin/require-scope ns-form vocabs))]
    (for [target (keys targets)]
      (let [ctx (assoc (kin/context {} target)
                       :vocabs vocabs :scope-syms scope
                       :targets targets
                       :locals (atom {}) :names (atom {}) :tmp (atom 0))]
        (doseq [f forms] (kin/kin-statement! ctx f))
        [target (kin/kin-output ctx)]))))

(let [[cmd path] *command-line-args*]
  (case cmd
    "gen" (doseq [[t text] (generate path)]
            (println (str "==== " (name t) " ===================================="))
            (print text) (println))
    (do (println "kin: unknown command" (pr-str cmd))
        (println "usage: kin gen|verify|emit <source.kin>")
        (System/exit 2))))
